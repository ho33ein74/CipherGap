
{
  "manifest_version": 3,
  "name": "CipherGap",
  "version": "1.0",
  "description": "Client-side encrypted messages and files for Bale Web.",

  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.bale.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.bale.ai/*"
      ],
      "js": [
        "content/utils.js",
        "content/storage.js",
        "content/crypto.js",
        "content/file_crypto.js",
        "content/dh_crypto.js",
        "content/packet.js",
        "content/messenger_adapter.js",
        "content/key_exchange.js",
        "content/bale.js",
        "content/messenger.js",
        "content/observer.js",
        "content/content.js"
      ]
    }
  ],

  "action": {
    "default_title": "CipherGap",
    "default_popup": "popup/popup.html"
  }
}
